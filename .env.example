# .env.example — copy to .env and fill in. Never commit a real .env.
# All values below are placeholders.
#
# NOTE: the Python servers do NOT load this file themselves. `docker compose`
# reads it for POSTGRES_PORT / POSTGRES_PASSWORD; for the MCP servers, export
# the variables in your shell, pass them via your MCP client's "env" block, or
# use e.g. `uv run --env-file .env dialogflow-mcp-remote`.

# ── Google Cloud / Dialogflow ───────────────────────────────
# GCP project that hosts the Dialogflow agent.
GCP_PROJECT=your-gcp-project-id
# Dialogflow location/region (e.g. global, us-central1, europe-west2).
DF_LOCATION=global
# Optional Dialogflow environment name (empty = draft agent).
DF_ENVIRONMENT=
# Dialogflow CX agent ID (only needed for the CX server).
DF_AGENT_ID=
# Google credentials. Locally, Application Default Credentials are used
# (`gcloud auth application-default login`, or GOOGLE_APPLICATION_CREDENTIALS
# set to a key-file path). On hosts without file mounts (Railway), paste the
# whole service-account key JSON into GOOGLE_APPLICATION_CREDENTIALS_JSON
# instead. It wins over ADC when set.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ── PostgreSQL ──────────────────────────────────────────────
# Connection string used by the MCP server (port 5433 avoids conflict with host Postgres, 127.0.0.1 avoids IPv6 localhost mismatch on Windows).
# REQUIRED for the remote server, which refuses to start without it. The stdio
# servers fall back to this local docker compose database when it is unset.
DATABASE_URL=postgresql://mcp:mcp_local_dev@127.0.0.1:5433/dialogflow_mcp
POSTGRES_PORT=5433
# Maximum connections in the psycopg connection pool (default 5).
DB_POOL_MAX=5
# Ping each pooled connection when it is handed out (default on). One extra
# round trip per checkout; keeps a connection dropped by Neon or a proxy from
# failing the next query. Set off for a nearby, stable database.
# DB_POOL_CHECK=on
# Password for the docker-compose postgres service (defaults to mcp_local_dev).
# If you change it, update DATABASE_URL to match.
POSTGRES_PASSWORD=mcp_local_dev

# ── Remote (HTTP/SSE) server ────────────────────────────────
# Bearer token clients must send. REQUIRED for remote deployment, min 16 chars.
# Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=replace-with-a-long-random-token
# OPTIONAL separate admin token. Only callers sending it may run the admin
# tools (update_order_status, get_recent_orders, get_conversation_logs); the
# MCP_AUTH_TOKEN holders get an "admin tool" error from them. Min 16 chars,
# must differ from MCP_AUTH_TOKEN. Setting it turns the admin tools on; don't
# also set MCP_ADMIN_TOOLS=off, or the server refuses to start. Leave empty for no admin role. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Both tokens are shared secrets, not per-user logins: no identities, no audit.
MCP_ADMIN_TOKEN=
# Comma-separated EXTRA Host header values (DNS-rebinding protection).
# localhost / 127.0.0.1 / [::1] (any port) are always allowed; add your public
# hostname here (e.g. mcp.example.com) or requests through it get HTTP 421.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated EXTRA Origin values for browser clients
# (http://localhost:*, http://127.0.0.1:*, http://[::1]:* are always allowed).
MCP_ALLOWED_ORIGINS=http://localhost
# Remote transport: streamable-http | sse
MCP_TRANSPORT=streamable-http
# Expose admin/write tools: on | off
# Default: on for stdio, off for remote. A blank value counts as unset. Left
# commented out so that filling in MCP_ADMIN_TOKEN works without a startup conflict.
# MCP_ADMIN_TOOLS=off
# Bind address and port for the remote server. The code default for HOST is
# 0.0.0.0 (all interfaces, needed inside a container); 127.0.0.1 is the safer
# choice when a TLS reverse proxy runs on the same machine.
HOST=127.0.0.1
PORT=8000
